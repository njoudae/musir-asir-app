# Server
PORT=3000
NODE_ENV=development
APP_SECRET=replace-with-a-long-random-secret
ADMIN_PIN=2468
DEV_OTP_EXPOSE=true
DATA_PROVIDER=convex
CONVEX_URL=
MUSIR_SERVICE_SECRET=

# SMS: "console" for local development, "unifonic" for real SMS
SMS_PROVIDER=console
OTP_DELIVERY_MODE=onscreen
UNIFONIC_APP_SID=
UNIFONIC_SENDER_ID=MUSIR

# Document extraction: "mock" for UI development, "openai" for production
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Ticket validity in hours
TICKET_VALIDITY_HOURS=1
